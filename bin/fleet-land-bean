#!/usr/bin/env bash
# fleet-land-bean <bean> — land ONE approved bean to LOCAL main by cherry-picking the bean's own
# branch (fleet/<coder>-<bean>), NOT the bare fleet/<coder>. Fail-safe: cherry-picks in an ISOLATED
# scratch worktree; real main is fast-forwarded ONLY if the cherry-pick is clean AND the gates pass.
# NEVER pushes (deploy stays a human step or fleet-push). Anything that conflicts or fails is left for
# manual landing under state/needs-land. Local commit only.
#
# git isolation: MAIN() acts on the repo checkout (branch main); WT() acts on the scratch worktree's
# OWN HEAD. NEVER pass --git-dir with -C <worktree> — it overrides the worktree and hits main.
#
# Gates (all optional; set in ~/.config/drover/config; empty = skipped):
#   DROVER_TYPECHECK     fast per-bean typecheck, run at the worktree root     (e.g. 'npx tsc --noEmit')
#   DROVER_TEST_CHANGED  per-bean tests for the changed files, with $CHANGED = the space-separated
#                        paths                (e.g. 'npx jest --findRelatedTests $CHANGED --passWithNoTests')
# The FULL cumulative suite runs at the push boundary (fleet-verify-main), not here — so lands stay
# fast and a coder never starves behind a serial full-suite.
set -u
# shellcheck source=drover-env
. "$(dirname "$0")/drover-env"
REPO="${DROVER_REPO:?set DROVER_REPO}"; STATE="$FLEET_STATE"; LEDGER="$FLEET_LEDGER"
MAIN(){ git -C "$REPO" "$@"; }
bean="${1:-}"; [ -n "$bean" ] || { echo "usage: fleet-land-bean <bean>"; exit 2; }
# Single-flight guard: only ONE land runs at a time. Two concurrent lands of the same bean (a retry
# storm when a genuinely-broken bean keeps being re-picked) can melt the box and hold the land lock,
# starving the deploy. Skip (bean stays approved, retried next tick — do NOT flag: a busy gate is not
# a land failure) if a land is already running; steal a stale lock whose owner has died. Separate lock
# from fleet-verify-main's so a land and a verify can coexist (2 heavy gates max, never a pile-up).
LLOCK="$FLEET_STATE/.land-bean-lock"; mkdir -p "$FLEET_STATE"
if ! mkdir "$LLOCK" 2>/dev/null; then
  lop=$(cat "$LLOCK/pid" 2>/dev/null)
  if [ -n "$lop" ] && kill -0 "$lop" 2>/dev/null; then echo "land: another land running (pid $lop) — skip $bean this tick"; exit 3; fi
  rm -rf "$LLOCK"; mkdir "$LLOCK" 2>/dev/null || { echo "land: cannot acquire land lock — skip $bean"; exit 3; }
fi
echo $$ > "$LLOCK/pid"; trap 'rm -rf "$LLOCK"' EXIT
mkdir -p "$STATE/needs-land" "$(dirname "$LEDGER")"
ledger(){ printf '%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$1" "$bean" >> "$LEDGER" 2>/dev/null; }
# clear the approved marker on flag: a flagged bean is NOT cleanly-approved-to-land — it needs a
# fix/rebase. Leaving approved set makes it an APPROVED-ZOMBIE that top_up skips (approved) AND
# auto_land skips (needs-land) forever, clogging the queue and starving coders.
flag(){ echo "$1" > "$STATE/needs-land/$bean"; rm -f "$STATE/approved/$bean"; ledger FLAGGED; echo "SKIP $bean — $1"; }

[ "$(MAIN rev-parse --abbrev-ref HEAD 2>/dev/null)" = "${DROVER_MAIN_BRANCH}" ] || { flag "repo not on ${DROVER_MAIN_BRANCH}"; exit 1; }

# resolve the bean's branch: prefer the owner's, else the unique one
owner=$(cat "$STATE/owner/$bean" 2>/dev/null | tr -d '[:space:]')
br=""
if [ -n "$owner" ] && MAIN show-ref -q "refs/heads/fleet/${owner}-${bean}"; then
  br="fleet/${owner}-${bean}"
else
  matches=$(MAIN for-each-ref --format='%(refname:short)' "refs/heads/fleet/*-${bean}" 2>/dev/null)
  cnt=$(printf '%s\n' "$matches" | grep -c .)
  if [ "$cnt" -eq 1 ]; then br="$matches"
  elif [ "$cnt" -gt 1 ]; then flag "ambiguous branch ($cnt matches) — set owner marker"; exit 1; fi
fi
[ -n "$br" ] || { flag "no fleet branch for $bean"; exit 1; }

# the bean's own commits = main..br. Cherry-pick only NON-merge work commits (branches that merged main
# carry merge commits that just re-bring main, already on main). Refuse a stale/huge branch.
picks=$(MAIN rev-list --reverse --no-merges "${DROVER_MAIN_BRANCH}..$br" 2>/dev/null)
if [ -z "$picks" ]; then
  flag "nothing ahead of ${DROVER_MAIN_BRANCH} on $br (already landed?)"
  MAIN update-ref -d "refs/heads/$br" 2>/dev/null; rm -f "$STATE/approved/$bean"
  ( cd "$REPO" && beans update "$bean" -s completed >/dev/null 2>&1 )
  echo "note: $bean had no new commits — cleared approved marker"; exit 0
fi
n_picks=$(printf '%s\n' "$picks" | grep -c .)
[ "$n_picks" -gt 40 ] && { flag "$n_picks commits ahead — $DROVER_LAND_STALE, land manually"; exit 1; }

# ISOLATED scratch worktree at current main; cherry-pick there. WT() = the worktree's own HEAD.
wt="$STATE/land-wt/$bean.$$"
rm -rf "$wt"; mkdir -p "$(dirname "$wt")"
MAIN worktree add -q --detach "$wt" ${DROVER_MAIN_BRANCH} || { flag "worktree add failed"; exit 1; }
WT(){ git -C "$wt" "$@"; }
base=$(WT rev-parse HEAD)
cleanup(){ WT cherry-pick --abort 2>/dev/null; MAIN worktree remove --force "$wt" 2>/dev/null; rm -rf "$wt"; }

for c in $picks; do   # SHAs are single tokens — word-splitting is safe here
  if ! WT cherry-pick -x "$c" >/dev/null 2>&1; then
    # stopped with nothing to commit: this commit's change is already on main (landed under another sha)
    if [ -z "$(WT diff --name-only --diff-filter=U)" ] && WT diff --quiet && WT diff --cached --quiet; then
      WT cherry-pick --skip >/dev/null 2>&1 || { cleanup; flag "cherry-pick $c empty but could not be skipped"; exit 1; }
      continue
    fi
    # a conflict only in bean files is safe to take --theirs; a conflict in any other file is a manual land
    nonbean=0
    while IFS= read -r f; do [ -n "$f" ] || continue; case "$f" in .beans/*) ;; *) nonbean=$((nonbean+1));; esac; done < <(WT diff --name-only --diff-filter=U)
    any=$(WT diff --name-only --diff-filter=U | grep -c .)
    if [ "$any" -gt 0 ] && [ "$nonbean" -eq 0 ]; then
      while IFS= read -r f; do [ -n "$f" ] || continue; WT checkout --theirs -- "$f" 2>/dev/null; WT add -- "$f"; done < <(WT diff --name-only --diff-filter=U)
      WT cherry-pick --continue --no-edit >/dev/null 2>&1 || { cleanup; flag "cherry-pick $c stuck after bean resolve"; exit 1; }
    else
      cleanup; flag "$DROVER_LAND_CONFLICT on ${c:0:9} — manual land"; exit 1
    fi
  fi
done
tip=$(WT rev-parse HEAD)
if [ "$tip" = "$base" ]; then   # every commit was already on main: nothing to land, nothing to flag
  cleanup; rm -f "$STATE/approved/$bean" "$STATE/needs-land/$bean"; ledger ALREADY-LANDED
  ( cd "$REPO" && beans update "$bean" -s completed >/dev/null 2>&1 )
  echo "note: $bean is already on ${DROVER_MAIN_BRANCH} (via $br) — cleared approved marker"; exit 0
fi
diffnames=$(WT diff --name-only ${DROVER_MAIN_BRANCH} "$tip")

# a fresh worktree has no deps; symlink the repo's installed ones so a typecheck/test resolves imports
for d in ${DROVER_CLONE_DIRS:-node_modules}; do
  [ -e "$wt/$d" ] || { mkdir -p "$(dirname "$wt/$d")" 2>/dev/null; ln -s "$REPO/$d" "$wt/$d" 2>/dev/null; }
done

changed_args=""
changed_file="$STATE/land-$bean-changed.txt"
# Newline path list for gates. Do NOT put thousands of paths into CHANGED= env: Linux
# MAX_ARG_STRLEN (128KiB) aborts exec with "Argument list too long" (forum-1f42: 2405 files).
printf '%s\n' "$diffnames" > "$changed_file"
run_gate(){  # $1=cmd  $2=log-tag  $3=stall-seconds ; runs in $wt with CHANGED_FILE (+ small CHANGED). Reads the LOG:
             # kills ONLY after $3s with NO new output (a genuine hang), never on total elapsed time. A
             # synthetic wall-clock cap SIGKILLs slow-but-healthy gates under load and false-fails good
             # beans (2026-09-21). The gate command must emit progress (jest prints PASS/FAIL per suite).
  local logf="$STATE/land-$bean-$2.log"
  ( cd "$wt" && CHANGED_FILE="$changed_file" CHANGED="$changed_args" sh -c "$1" ) >"$logf" 2>&1 &
  local p=$! last=-1 quiet=0 sz
  while kill -0 "$p" 2>/dev/null; do
    sleep 10
    sz=$(wc -c < "$logf" 2>/dev/null); sz=${sz:-0}
    if [ "$sz" != "$last" ]; then last=$sz; quiet=0; else quiet=$((quiet+10)); fi
    [ "$quiet" -ge "$3" ] && { kill -9 "$p" 2>/dev/null; wait "$p" 2>/dev/null; return 124; }
  done
  wait "$p" 2>/dev/null; return $?
}

if [ -n "${DROVER_TYPECHECK:-}" ]; then
  run_gate "$DROVER_TYPECHECK" tc "${DROVER_GATE_STALL:-300}"; grc=$?
  [ "$grc" -eq 124 ] && { cleanup; flag "typecheck STALLED — no output ${DROVER_GATE_STALL:-300}s (hung, not a clock) — manual land ($STATE/land-$bean-tc.log)"; exit 1; }
  [ "$grc" -eq 0 ]   || { cleanup; flag "typecheck failed on cherry-pick — manual land ($STATE/land-$bean-tc.log)"; exit 1; }
fi
if [ -n "${DROVER_TEST_CHANGED:-}" ]; then
  # Keep CHANGED for small diffs / older gate scripts; omit when it would exceed MAX_ARG_STRLEN.
  if [ "$(wc -c < "$changed_file")" -lt 100000 ]; then
    changed_args=$(tr '\n' ' ' < "$changed_file")
  else
    changed_args=""
  fi
  run_gate "$DROVER_TEST_CHANGED" test "${DROVER_GATE_STALL:-300}"; grc=$?
  [ "$grc" -eq 124 ] && { cleanup; flag "related tests STALLED — no output ${DROVER_GATE_STALL:-300}s (hung, not a clock) — manual land ($STATE/land-$bean-test.log)"; exit 1; }
  [ "$grc" -eq 0 ]   || { cleanup; flag "$DROVER_LAND_TESTS on cherry-pick — manual land ($STATE/land-$bean-test.log)"; exit 1; }
fi

if [ "${FLEET_LAND_DRY:-0}" = 1 ]; then
  cleanup; echo "DRY $bean via $br ($n_picks commit) — clean cherry-pick, gates OK; would ff ${DROVER_MAIN_BRANCH} to ${tip:0:9} (no write)"; exit 0
fi
# advance LOCAL main by fast-forward only (never a merge, never a push). Serial caller avoids races.
# main moving mid-land (a harvest or bean commit) is a RACE, not a land failure: do NOT flag. flag()
# writes needs-land, and auto_land skips every needs-land bean until a human clears it — so the old
# "main moved; retry" flag never retried (2026-09-22: one bean stuck 90 min, then all 7 approved beans
# flagged and nothing landed). Exit 3 like the busy lock: the bean stays approved and re-lands next tick.
#
# Board writes (`beans update` run in $DROVER_REPO by dispatch and land) are never committed by their
# writer, so main's .beans is routinely dirty, and ff refuses to overwrite a dirty bean file our commits
# touch (2026-09-22: every approved bean failed here, mislabelled "main moved"). Commit the board first —
# but NEVER a half-merged bean: conflict markers in one file's front matter make the whole beans CLI
# fail, so dispatch sees an empty board (2026-09-22). Such files stay dirty; if the land touches one the
# ff fails and the bean retries next tick.
board=()
while IFS= read -r f; do
  [ -n "$f" ] || continue
  grep -qE '^(<<<<<<<|>>>>>>>) ' "$REPO/$f" 2>/dev/null && continue
  board+=("$f")
done < <(MAIN status --porcelain -- .beans | awk '{print $NF}')
if [ ${#board[@]} -gt 0 ]; then
  MAIN add -- "${board[@]}" && MAIN commit --only --no-verify -q -m "chore(beans): sync board state" -- "${board[@]}"
fi
# main advanced mid-land: bean-only drift -> replay onto it (the gated code is unchanged); code drift ->
# retry next tick, which re-cherry-picks and re-gates against the new main.
if ! MAIN merge-base --is-ancestor ${DROVER_MAIN_BRANCH} "$tip"; then
  drift=$(MAIN diff --name-only "$(WT merge-base HEAD ${DROVER_MAIN_BRANCH})" ${DROVER_MAIN_BRANCH} -- . ':(exclude).beans')
  if [ -n "$drift" ]; then cleanup; echo "RETRY $bean — ${DROVER_MAIN_BRANCH} code moved during land; stays approved, re-lands next tick"; exit 3; fi
  WT rebase -q -X theirs ${DROVER_MAIN_BRANCH} 2>"$STATE/land-$bean-rebase.log" || { WT rebase --abort 2>/dev/null; cleanup; echo "RETRY $bean — bean-only rebase failed ($STATE/land-$bean-rebase.log)"; exit 3; }
  tip=$(WT rev-parse HEAD)
fi
if ! MAIN merge --ff-only "$tip" 2>"$STATE/land-$bean-ff.log"; then cleanup; echo "RETRY $bean — ff failed ($STATE/land-$bean-ff.log); stays approved"; exit 3; fi
cleanup; rm -f "$STATE/needs-land/$bean"
( cd "$REPO" && beans update "$bean" -s completed >/dev/null 2>&1 )
rm -f "$STATE/approved/$bean" "$STATE/owner/$bean"
ledger LANDED
echo "LANDED $bean via $br ($n_picks commit) -> local ${DROVER_MAIN_BRANCH} $(MAIN rev-parse --short HEAD); NOT pushed"
