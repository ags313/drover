# drover-env — sourced by every drover script. Not executable on its own.
#
# One config file, plain shell. Write values as ${VAR:-value} so the environment wins:
#   DROVER_REPO="${DROVER_REPO:-$HOME/src/myproject}"
# Every path below can be overridden the same way.
#
# Several projects (install.sh --project NAME): each has its own config, ~/.config/drover/projects/NAME/config,
# and its own state, ~/.local/share/drover/projects/NAME; DROVER_PROJECT=NAME picks one. The units and seat
# panes have it set. Without it, a script run inside a project's checkout or one of its worktrees finds the
# project by its repository, so a seat's fleet-done always announces into its own project's inbox, never
# into another's. Without projects, nothing below changes: one config, one state dir.
DROVER_PROJECTS_DIR="${DROVER_PROJECTS_DIR:-$HOME/.config/drover/projects}"
if [ -z "${DROVER_PROJECT:-}" ] && [ -z "${DROVER_CONFIG:-}" ] && [ -d "$DROVER_PROJECTS_DIR" ] &&
   _drover_git=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) &&
   _drover_git=$(cd "$_drover_git" && pwd -P); then
  for _drover_c in "$DROVER_PROJECTS_DIR"/*/config; do
    [ -f "$_drover_c" ] || continue
    # shellcheck disable=SC1090
    _drover_r=$(unset DROVER_REPO; . "$_drover_c" >/dev/null 2>&1; printf '%s' "${DROVER_REPO:-}")
    if [ -n "$_drover_r" ] && [ "$(cd "$_drover_r/.git" 2>/dev/null && pwd -P)" = "$_drover_git" ]; then
      DROVER_PROJECT=$(basename "$(dirname "$_drover_c")"); break
    fi
  done
  unset _drover_git _drover_c _drover_r
fi
if [ -n "${DROVER_PROJECT:-}" ]; then
  export DROVER_PROJECT   # scripts call each other: a child must not detect again, or detect differently
  DROVER_CONFIG="${DROVER_CONFIG:-$DROVER_PROJECTS_DIR/$DROVER_PROJECT/config}"
  DROVER_HOME="${DROVER_HOME:-$HOME/.local/share/drover/projects/$DROVER_PROJECT}"
  [ -f "$DROVER_CONFIG" ] || echo "drover: project $DROVER_PROJECT has no config at $DROVER_CONFIG" >&2
fi
DROVER_CONFIG="${DROVER_CONFIG:-$HOME/.config/drover/config}"
# shellcheck disable=SC1090
[ -f "$DROVER_CONFIG" ] && . "$DROVER_CONFIG"

# The directory these scripts are installed in (install.sh symlinks them into ~/.local/bin), and the
# drover checkout they came from (for skills/ and docs/). Scripts call each other through
# $DROVER_BIN, never through PATH: a service manager's PATH is short, and `fleet` is also the name of an IDE CLI.
_drover_self="${BASH_SOURCE[0]}"
DROVER_BIN="$(cd "$(dirname "$_drover_self")" && pwd)"
while [ -L "$_drover_self" ]; do
  _drover_t=$(readlink "$_drover_self")
  case $_drover_t in /*) _drover_self=$_drover_t ;; *) _drover_self=$(dirname "$_drover_self")/$_drover_t ;; esac
done
DROVER_SRC="${DROVER_SRC:-$(cd "$(dirname "$_drover_self")/.." && pwd)}"
unset _drover_self _drover_t

DROVER_HOME="${DROVER_HOME:-$HOME/.local/share/drover}"
FLEET_QUEUE="${FLEET_QUEUE:-$DROVER_HOME/queue}"        # global FIFO: one empty file per bean, <epoch>-<bean>
FLEET_INBOX="${FLEET_INBOX:-$DROVER_HOME/inbox}"        # fleet-done writes one .msg per announcement
FLEET_TASKS="${FLEET_TASKS:-$DROVER_HOME/tasks}"        # one file per busy seat — the ONLY busy marker
FLEET_BRIEFS="${FLEET_BRIEFS:-$DROVER_HOME/briefs}"     # prompts are written here; agents get a one-line pointer
FLEET_REPORTS="${FLEET_REPORTS:-$DROVER_HOME/reports}"  # agents' reports and reviews
FLEET_STATE="${FLEET_STATE:-$DROVER_HOME/watch/state}"  # fleet-watch state (owner/, approved/, followups/, ...)
FLEET_LEDGER="${FLEET_LEDGER:-$DROVER_HOME/ledger.tsv}" # dispatch event log
FLEET_CAPS="${FLEET_CAPS:-$HOME/.config/drover/caps}"   # spend caps, re-read every tick

# The seats: name:harness pairs. The role is the name's last dash-separated word (coder, reviewer,
# pm, architect, analyst, sre, ...). A reviewer is always picked on a different harness from the coder.
DROVER_ROSTER="${DROVER_ROSTER:-claude-coder:claude codex-coder:codex opencode-coder:opencode claude-reviewer:claude codex-reviewer:codex opencode-reviewer:opencode}"
DROVER_LEAD_SEATS="${DROVER_LEAD_SEATS:-lead lead-backup}"   # never restarted by fleet-yolo

# The integration branch every landing goes to, and the remote it is pushed to. Landings, the queue's
# "is the bean on main" checks, the watcher's heal and every "is it landed/pushed" check use these. A project
# whose integration branch is not `main`, or whose `origin` is not where it deploys, sets them in its config.
DROVER_MAIN_BRANCH="${DROVER_MAIN_BRANCH:-main}"
DROVER_REMOTE="${DROVER_REMOTE:-origin}"
DROVER_UPSTREAM="$DROVER_REMOTE/$DROVER_MAIN_BRANCH"
# Scripts match paths from git's output by name (git ls-files .beans | grep "^.beans/$bean--"). git's default
# core.quotepath=true prints a byte above 0x80 as an octal escape inside quotes, so a bean file named
# "...dowódca..." never matched and refill skipped it as "not on main" on every tick (forum-1avw, 2026-10-13).
# Set it for every git these scripts and their children run, through the environment (it outranks every config
# file). GIT_CONFIG_COUNT may already list core.quotepath, more than once and in any letter case; git takes the
# LAST one, so a false is appended unless the last entry is already ours: the caller's entries are kept as they
# are, and sourcing twice does not add a second entry.
_drover_n=${GIT_CONFIG_COUNT:-0}
case $_drover_n in ''|*[!0-9]*) _drover_n=0 ;; esac   # git itself refuses a non-number here
_drover_k="GIT_CONFIG_KEY_$((_drover_n - 1))"; _drover_v="GIT_CONFIG_VALUE_$((_drover_n - 1))"
if [ "$_drover_n" = 0 ] || [ "${!_drover_k:-}" != core.quotepath ] || [ "${!_drover_v:-}" != false ]; then
  export "GIT_CONFIG_KEY_$_drover_n=core.quotepath" "GIT_CONFIG_VALUE_$_drover_n=false" GIT_CONFIG_COUNT=$((_drover_n + 1))
fi
unset _drover_n _drover_k _drover_v
# Push batching for fleet-watch auto_push (DROVER_AUTOLAND=1): wait until main is this many commits ahead of
# $DROVER_UPSTREAM before the verify+push starts; one land was one push and one CI run (panel2: 42 pushes on
# 2026-10-12). DROVER_PUSH_MAX_WAIT_MIN > 0 pushes a smaller batch anyway once its oldest unpushed commit is
# that many minutes old, so one bean never waits overnight. fleet-push (manual) ignores both.
DROVER_PUSH_MIN_AHEAD="${DROVER_PUSH_MIN_AHEAD:-1}"
DROVER_PUSH_MAX_WAIT_MIN="${DROVER_PUSH_MAX_WAIT_MIN:-0}"

# Reasons fleet-land-bean writes to state/needs-land/<bean> that are a coder's to fix. fleet-watch routes a
# flagged bean by matching these, so writer and matchers read one definition: the router once matched
# "content conflict in" while the writer said "content conflict on", and conflicted beans sat flagged forever.
DROVER_LAND_CONFLICT="content conflict"
DROVER_LAND_TESTS="related tests failed"
DROVER_LAND_STALE="stale branch"

# Where herdr puts each seat's worktree, and the beans id prefix (read from the repo's .beans.yml).
DROVER_WORKTREES="${DROVER_WORKTREES:-$HOME/.herdr/worktrees/$(basename "${DROVER_REPO:-repo}")}"
if [ -z "${DROVER_BEAN_PREFIX:-}" ] && [ -f "${DROVER_REPO:-/nonexistent}/.beans.yml" ]; then
  DROVER_BEAN_PREFIX=$(sed -n 's/^[[:space:]]*prefix:[[:space:]]*//p' "$DROVER_REPO/.beans.yml" | head -1 | tr -d "\"'")
fi
DROVER_BEAN_PREFIX="${DROVER_BEAN_PREFIX:-bean-}"
DROVER_BEAN_RE="${DROVER_BEAN_RE:-}"
[ -n "$DROVER_BEAN_RE" ] || DROVER_BEAN_RE="${DROVER_BEAN_PREFIX}[a-z0-9]{4}\\b"   # \b: a seat name like panel2-claude-coder must not match as panel2-clau. Not inside ${:-}: its {4} closes the expansion early.
# Bean ids cited in $1, one per line, first occurrence first. A seat named <prefix>-<role> shares the bean
# prefix (install.sh --project NAME seeds NAME-<role> seats), and \b still lets "drover-grok-coder" yield
# "drover-grok" and "drover-lead" match whole: a match that begins a seat name is that seat, not a bean.
# $2 = seats as "name[:kind] ..." (default: DROVER_ROSTER and DROVER_LEAD_SEATS).
drover_bean_ids(){
  local id s
  for id in $(printf '%s' "$1" | grep -oE "$DROVER_BEAN_RE" | awk '!seen[$0]++'); do
    for s in ${2-$DROVER_ROSTER $DROVER_LEAD_SEATS}; do case "${s%%:*}" in "$id"*) continue 2 ;; esac; done
    printf '%s\n' "$id"
  done
}

# stat and date take different flags in GNU coreutils (Linux, NixOS, or a Mac with coreutils first on PATH)
# and BSD (stock macOS). Probe the binaries, not the OS. On GNU `stat -f %m` is a filesystem query: it prints
# nothing usable and every age computed from it became $(( now - )), a syntax error.
#   drover_mtime FILE...          modification time, epoch seconds
#   drover_size FILE              size in bytes
#   drover_free_gb PATH           free GiB on PATH's filesystem (`df -g` is BSD-only; -P -k is POSIX)
#   drover_free_mem_gb            memory available to new work, GiB: Linux MemAvailable; macOS free + inactive +
#                                 speculative pages (vm_stat). Without either the answer was 0 and the load
#                                 guard refused every gate.
#   drover_clone SRC DST          copy a tree as a copy-on-write clone where the filesystem has them: BSD `cp -c` is
#                                 APFS clonefile; GNU `cp --reflink=auto` clones on btrfs/XFS/bcachefs and
#                                 falls back to a full copy (ext4: real disk and time).
#   drover_seed_dir SRC DST       give a gate worktree its own copy of a dependency tree (drover_clone). Next.js 16's
#                                 Turbopack refuses a symlink that points out of the project root, so a symlinked
#                                 node_modules failed `next build` on a green main. When the copy fails (no
#                                 copy-on-write and a disk too small for the tree) the partial copy is removed and
#                                 DST becomes a symlink to SRC.
#   drover_date_parse FMT STR     STR (laid out as strftime FMT) -> epoch seconds; fields STR lacks come from now.
#                                 GNU date ignores FMT and parses STR on its own; every FMT drover uses is one it reads.
if stat -c %Y / >/dev/null 2>&1; then
  drover_mtime(){ stat -c %Y "$@"; }
  drover_size(){ stat -c %s "$@"; }
else
  drover_mtime(){ stat -f %m "$@"; }
  drover_size(){ stat -f %z "$@"; }
fi
if cp --version >/dev/null 2>&1; then
  drover_clone(){ cp -R --reflink=auto "$1" "$2"; }
else
  drover_clone(){ cp -Rc "$1" "$2"; }
fi
drover_seed_dir(){
  [ -e "$2" ] || [ -L "$2" ] && return 0
  [ -d "$1" ] || return 0
  mkdir -p "$(dirname "$2")" 2>/dev/null
  drover_clone "$1" "$2" 2>/dev/null && return 0
  rm -rf "$2"; ln -s "$1" "$2" 2>/dev/null
}
if date -d @0 >/dev/null 2>&1; then
  drover_date_parse(){ date -d "$2" +%s; }
else
  drover_date_parse(){ date -j -f "$1" "$2" +%s; }
fi
drover_free_gb(){ df -P -k "$1" | awk 'NR==2{print int($4/1048576)}'; }
drover_free_mem_gb(){
  if [ -r /proc/meminfo ]; then awk '/^MemAvailable:/{print int($2/1048576); exit}' /proc/meminfo; return; fi
  local ps; ps=$(vm_stat | awk '/page size of/{print $8}'); ps=${ps:-16384}
  vm_stat | awk -v ps="$ps" '/Pages (free|inactive|speculative)/{gsub("\\.","",$NF); n+=$NF} END{printf "%d", n*ps/1073741824}'
}
