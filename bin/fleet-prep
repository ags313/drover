#!/usr/bin/env bash
# fleet-prep <seat> <bean> [worktree] — put a seat's worktree on fleet/<seat>-<bean> before it is briefed.
#   * leftover work in the tree is PARKED on a wip/<seat>-<time> branch (a commit: nothing is discarded)
#   * an existing fleet/<seat>-<bean> branch is RESUMED, never reset (a reset to origin/main orphaned READY commits)
#   * otherwise a new branch is cut from origin/main, so the bean file exists and the merge is clean
#   * the shared checkout (DROVER_REPO) is refused: no seat works there
# `fleet assign` calls this; run it by hand to recover a seat that reported BLOCKED on a dirty tree.
set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/drover-env"
[ $# -ge 2 ] || { echo "usage: fleet-prep <seat> <bean> [worktree]" >&2; exit 64; }
[ -n "${DROVER_REPO:-}" ] || { echo "fleet-prep: set DROVER_REPO (env or $DROVER_CONFIG)" >&2; exit 2; }
seat=$1 bean=$2; wt=${3:-$DROVER_WORKTREES/fleet-$seat}
[ -d "$wt" ] || { echo "no worktree $wt" >&2; exit 2; }
git -C "$DROVER_REPO" fetch -q origin main
cd "$wt"
[ "$(pwd -P)" != "$(cd "$DROVER_REPO" && pwd -P)" ] || { echo "refusing: $wt is the shared checkout" >&2; exit 2; }
if [ -n "$(git status --porcelain)" ]; then
  w=wip/$seat-$(date +%Y%m%d%H%M); git switch -q -c "$w"
  git add -A; git -c core.hooksPath=/dev/null commit -q --no-verify -m "wip: $seat leftover before $bean (parked by fleet-prep)"
  echo "parked WIP on $w"
fi
if git show-ref --verify -q "refs/heads/fleet/$seat-$bean"; then git switch -q "fleet/$seat-$bean"; else git switch -q -c "fleet/$seat-$bean" origin/main; fi
ls .beans/"${bean}"--* >/dev/null 2>&1 || { echo "fleet-prep: no bean file for $bean on this branch" >&2; exit 1; }
echo "$seat ready on $(git branch --show-current) @ $(git rev-parse --short HEAD)"
