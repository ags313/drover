#!/usr/bin/env bash
# fleet-branch-landed [branch] — prints the subjects of bean-named, non-merge commits on <branch> (default HEAD) that are NOT on the
# main branch BY SUBJECT. By subject, never by SHA: a rebase changes the SHA, so `merge-base --is-ancestor <old sha>` reports landed
# work as missing. Exit 0 = everything landed (or nothing to land); exit 1 = something is unlanded.
# On exit 1 the first line is "AGE <minutes>" (age of the OLDEST unlanded commit), then one subject per line.
# Runs in the current directory's repository unless FLEET_LANDED_REPO names one. (`fleet-landed-check` is the other tool: it audits
# COMPLETED beans; this one audits a BRANCH.)
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/drover-env"
br="${1:-HEAD}"; repo="${FLEET_LANDED_REPO:-.}"
g() { git -C "$repo" "$@"; }
g fetch -q origin main 2>/dev/null || true
miss=(); oldest=0; now=$(date +%s)
while IFS=$'\t' read -r ct subj; do
  [ -z "$subj" ] && continue
  case "$subj" in wip:*|Merge*) continue;; esac
  printf '%s' "$subj" | grep -qE "$DROVER_BEAN_RE" || continue          # base noise (commits that name no bean) is not this seat's work
  if [ -z "$(g log origin/main -F --grep="${subj:0:70}" --format=%h -1 2>/dev/null)" ]; then
    miss+=("$subj"); a=$(( (now-ct)/60 )); [ "$a" -gt "$oldest" ] && oldest=$a
  fi
done < <(g log origin/main.."$br" --no-merges --format=$'%ct\t%s' 2>/dev/null)
[ ${#miss[@]} -eq 0 ] && exit 0
echo "AGE $oldest"; printf '%s\n' "${miss[@]}"; exit 1
