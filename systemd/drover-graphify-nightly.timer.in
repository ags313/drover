# Rendered by install.sh into ~/.config/systemd/user. PATH below is the PATH install.sh ran with: user units
# do not read your shell rc files, so rerun install.sh after a tool moves.
[Unit]
Description=drover nightly knowledge-graph rebuild (timer)

[Timer]
# launchd: StartCalendarInterval 03:30; a run missed while asleep runs on wake, as launchd does
OnCalendar=*-*-* 03:30:00
Persistent=true

[Install]
WantedBy=timers.target
